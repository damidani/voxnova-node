{
  "name": "@voxnova/sdk",
  "version": "1.1.1",
  "description": "SDK TypeScript de la plateforme VoxNova : API REST (SMS, endpoints, numéros, appels, scénarios d'appel, espace revendeur), instructions vocales, vérification des webhooks",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damidani/voxnova-node.git"
  },
  "keywords": [
    "voip",
    "sip",
    "telephony",
    "webhooks",
    "ivr",
    "voxnova"
  ],
  "homepage": "https://github.com/damidani/voxnova-node#readme",
  "bugs": {
    "url": "https://github.com/damidani/voxnova-node/issues"
  }
}
